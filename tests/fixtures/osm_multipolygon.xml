<?xml version="1.0" encoding="UTF-8"?>
<osm version="0.6">
  <bounds minlat="51.049" minlon="3.719" maxlat="51.055" maxlon="3.725"/>

  <!-- Nodes for building with courtyard (multipolygon relation) -->
  <!-- Outer ring: large rectangle -->
  <node id="1001" lat="51.0500" lon="3.7200"/>
  <node id="1002" lat="51.0500" lon="3.7210"/>
  <node id="1003" lat="51.0506" lon="3.7210"/>
  <node id="1004" lat="51.0506" lon="3.7200"/>
  <!-- Inner ring: small courtyard -->
  <node id="1011" lat="51.0502" lon="3.7203"/>
  <node id="1012" lat="51.0502" lon="3.7207"/>
  <node id="1013" lat="51.0504" lon="3.7207"/>
  <node id="1014" lat="51.0504" lon="3.7203"/>

  <!-- Outer way (closed polygon) -->
  <way id="2001">
    <nd ref="1001"/>
    <nd ref="1002"/>
    <nd ref="1003"/>
    <nd ref="1004"/>
    <nd ref="1001"/>
    <tag k="building" v="yes"/>
  </way>

  <!-- Inner way (courtyard hole) -->
  <way id="2002">
    <nd ref="1011"/>
    <nd ref="1012"/>
    <nd ref="1013"/>
    <nd ref="1014"/>
    <nd ref="1011"/>
  </way>

  <!-- Multipolygon relation: building with courtyard -->
  <relation id="3001">
    <member type="way" ref="2001" role="outer"/>
    <member type="way" ref="2002" role="inner"/>
    <tag k="type" v="multipolygon"/>
    <tag k="building" v="yes"/>
    <tag k="height" v="15"/>
    <tag k="building:material" v="brick"/>
  </relation>

  <!-- Nodes for building with parts (building relation) -->
  <!-- Outline footprint -->
  <node id="4101" lat="51.0508" lon="3.7200"/>
  <node id="4102" lat="51.0508" lon="3.7212"/>
  <node id="4103" lat="51.0512" lon="3.7212"/>
  <node id="4104" lat="51.0512" lon="3.7200"/>
  <!-- Part A (left half) -->
  <node id="2011" lat="51.0508" lon="3.7200"/>
  <node id="2012" lat="51.0508" lon="3.7206"/>
  <node id="2013" lat="51.0512" lon="3.7206"/>
  <node id="2014" lat="51.0512" lon="3.7200"/>
  <!-- Part B (right half, taller) -->
  <node id="2021" lat="51.0508" lon="3.7206"/>
  <node id="2022" lat="51.0508" lon="3.7212"/>
  <node id="2023" lat="51.0512" lon="3.7212"/>
  <node id="2024" lat="51.0512" lon="3.7206"/>

  <!-- Outline way -->
  <way id="4001">
    <nd ref="4101"/>
    <nd ref="4102"/>
    <nd ref="4103"/>
    <nd ref="4104"/>
    <nd ref="4101"/>
    <tag k="building" v="yes"/>
  </way>

  <!-- Part A: low section -->
  <way id="4002">
    <nd ref="2011"/>
    <nd ref="2012"/>
    <nd ref="2013"/>
    <nd ref="2014"/>
    <nd ref="2011"/>
    <tag k="building:part" v="yes"/>
    <tag k="height" v="8"/>
  </way>

  <!-- Part B: tall section -->
  <way id="4003">
    <nd ref="2021"/>
    <nd ref="2022"/>
    <nd ref="2023"/>
    <nd ref="2024"/>
    <nd ref="2021"/>
    <tag k="building:part" v="yes"/>
    <tag k="height" v="20"/>
  </way>

  <!-- Building relation with parts -->
  <relation id="5001">
    <member type="way" ref="4001" role="outline"/>
    <member type="way" ref="4002" role="part"/>
    <member type="way" ref="4003" role="part"/>
    <tag k="type" v="building"/>
    <tag k="building" v="yes"/>
  </relation>

  <!-- Nodes for two open ways that need to be joined into a closed ring -->
  <node id="3001" lat="51.0515" lon="3.7200"/>
  <node id="3002" lat="51.0515" lon="3.7205"/>
  <node id="3003" lat="51.0515" lon="3.7210"/>
  <node id="3004" lat="51.0520" lon="3.7210"/>
  <node id="3005" lat="51.0520" lon="3.7200"/>

  <!-- Open way 1: 3001 -> 3002 -> 3003 -->
  <way id="6001">
    <nd ref="3001"/>
    <nd ref="3002"/>
    <nd ref="3003"/>
  </way>

  <!-- Open way 2: 3003 -> 3004 -> 3005 -> 3001 -->
  <way id="6002">
    <nd ref="3003"/>
    <nd ref="3004"/>
    <nd ref="3005"/>
    <nd ref="3001"/>
  </way>

  <!-- Multipolygon relation using two open ways that together form a ring -->
  <relation id="7001">
    <member type="way" ref="6001" role="outer"/>
    <member type="way" ref="6002" role="outer"/>
    <tag k="type" v="multipolygon"/>
    <tag k="building" v="yes"/>
    <tag k="height" v="6"/>
  </relation>

</osm>

  "concepts": [
{"prompt": "brick facade", "kind": "surface", "entity": {"facade": 1.0}, "material": {"brick": 0.92, "ceramic": 0.05, "concrete": 0.03}, "attributes": {"fixed": 0.99, "rough": 0.9, "porous": 0.8, "layered": 0.4},
     "caveat": "Facing brick hides whether the wall behind it is solid, cavity or hollow-core, and the effective permittivity of the three differs by more than the ITU row's own spread."},
{"prompt": "painted brick wall", "kind": "surface", "entity": {"facade": 1.0}, "material": {"brick": 0.8, "plasterboard": 0.1, "concrete": 0.05, "unknown": 0.05}, "attributes": {"fixed": 0.99, "rough": 0.6, "smooth": 0.4, "porous": 0.4, "layered": 0.75},
     "caveat": "Paint is electrically thin at millimetre wave and does not change the bulk dielectric, but it does seal the surface, so the roughness prior tightens while the permittivity prior does not move."},
{"prompt": "ashlar stone facade", "kind": "surface", "entity": {"facade": 1.0}, "material": {"marble": 0.8, "concrete": 0.1, "unknown": 0.1}, "attributes": {"fixed": 0.99, "smooth": 0.65, "rough": 0.35, "layered": 0.3},
     "caveat": "Dressed stone. The visual cue is the joint pattern and surface finish, not the rock type, and marble is the only dimension-stone row in the ITU table."},
{"prompt": "rubble stone masonry wall", "kind": "surface", "entity": {"facade": 1.0}, "material": {"marble": 0.72, "concrete": 0.13, "unknown": 0.15}, "attributes": {"fixed": 0.99, "rough": 0.97, "porous": 0.5},
     "caveat": "Carries the same dielectric prior as ashlar and a very different roughness prior. That split is the point: at 28 GHz the specular fraction of a stone wall is set by its RMS height, not by its permittivity."},
{"prompt": "plaster facade", "kind": "surface", "entity": {"facade": 1.0}, "material": {"plasterboard": 0.45, "concrete": 0.2, "brick": 0.15, "unknown": 0.2}, "attributes": {"fixed": 0.99, "smooth": 0.7, "layered": 0.95},
     "caveat": "Render conceals its substrate completely. The residual mass on brick, concrete and unknown is the substrate ambiguity, and it also covers external wall insulation, which is now common, looks identical, and behaves nothing like the masonry it wraps."},
{"prompt": "exposed concrete wall", "kind": "surface", "entity": {"facade": 1.0}, "material": {"concrete": 0.93, "unknown": 0.07}, "attributes": {"fixed": 0.99, "rough": 0.55, "smooth": 0.4, "layered": 0.3}},
{"prompt": "marble cladding", "kind": "surface", "entity": {"facade": 1.0}, "material": {"marble": 0.85, "concrete": 0.08, "unknown": 0.07}, "attributes": {"fixed": 0.99, "smooth": 0.85, "thin": 0.6, "layered": 0.85},
     "caveat": "Cladding is a thin skin on a backing wall, so the propagation model needs a two-layer slab and the imagery gives neither layer's thickness."},
{"prompt": "ceramic tile facade", "kind": "surface", "entity": {"facade": 1.0}, "material": {"ceramic": 0.8, "brick": 0.1, "unknown": 0.1}, "attributes": {"fixed": 0.99, "smooth": 0.8, "thin": 0.6, "layered": 0.9, "periodic": 0.6},
     "caveat": "Ceramic has no ITU-R P.2040-4 row at all, so this concept resolves the surface without resolving its dielectric model."},
{"prompt": "glass curtain wall", "kind": "surface", "entity": {"facade": 0.6, "window": 0.4}, "material": {"glass": 0.85, "metal": 0.1, "unknown": 0.05}, "attributes": {"fixed": 0.99, "thin": 0.7, "reflective": 0.95, "transparent": 0.7, "smooth": 0.98, "layered": 0.9, "metallised": 0.6},
     "caveat": "This is the standard example of what imagery cannot settle. A low-emissivity or solar-control coating is a few tens of nanometres of silver and is close to invisible in a street photograph, yet it turns a partly transmitting panel into a near mirror with tens of dB of extra transmission loss. The metallised prior of 0.6 is a prior over modern commercial glazing, not a detection."},
{"prompt": "glass window", "kind": "surface", "entity": {"window": 1.0}, "material": {"glass": 0.93, "wood": 0.03, "unknown": 0.04}, "attributes": {"fixed": 0.95, "thin": 0.75, "reflective": 0.9, "transparent": 0.95, "smooth": 0.95, "layered": 0.65, "metallised": 0.2},
     "caveat": "Single, double and triple glazing are not separable at street level, and they differ by cavity count, which sets the interference structure of the slab response."},
{"prompt": "shop window", "kind": "surface", "entity": {"window": 1.0}, "material": {"glass": 0.9, "metal": 0.06, "unknown": 0.04}, "attributes": {"fixed": 0.95, "thin": 0.7, "reflective": 0.9, "transparent": 0.9, "smooth": 0.97, "layered": 0.6, "metallised": 0.3},
     "caveat": "Ground-floor retail glazing is the panel a pedestrian actually stands in front of, so it is separated from upper-storey windows despite sharing a dielectric prior."},
{"prompt": "metal cladding panel", "kind": "surface", "entity": {"facade": 1.0}, "material": {"metal": 0.93, "unknown": 0.07}, "attributes": {"fixed": 0.98, "thin": 0.8, "reflective": 0.9, "smooth": 0.8, "conductive": 0.97, "layered": 0.7}},
{"prompt": "corrugated metal sheet", "kind": "surface", "entity": {"facade": 1.0}, "material": {"metal": 0.93, "unknown": 0.07}, "attributes": {"fixed": 0.95, "thin": 0.85, "reflective": 0.85, "rough": 0.5, "conductive": 0.97, "periodic": 0.95},
     "caveat": "Periodic at a pitch of roughly 3 to 10 cm, which is 3 to 10 wavelengths at 28 GHz, so it behaves as a reflection grating rather than as a rough plane. Nothing downstream models that yet, which is why the periodic attribute exists."},
{"prompt": "metal roller shutter", "kind": "surface", "entity": {"shutter": 1.0}, "material": {"metal": 0.9, "polymer": 0.05, "unknown": 0.05}, "attributes": {"fixed": 0.7, "movable": 0.8, "thin": 0.9, "reflective": 0.8, "conductive": 0.95, "periodic": 0.9},
     "caveat": "A shutter changes a shopfront from glass to metal on a daily cycle, so the surface it names is genuinely time varying and a single panorama samples one state of it."},
{"prompt": "timber cladding", "kind": "surface", "entity": {"facade": 1.0}, "material": {"wood": 0.9, "unknown": 0.1}, "attributes": {"fixed": 0.98, "rough": 0.6, "porous": 0.6, "periodic": 0.5, "layered": 0.6}},
{"prompt": "half-timbered facade", "kind": "surface", "entity": {"facade": 1.0}, "material": {"wood": 0.4, "plasterboard": 0.3, "brick": 0.2, "unknown": 0.1}, "attributes": {"fixed": 0.99, "rough": 0.6, "layered": 0.8},
     "caveat": "A single mask covers two materials in a fixed geometric pattern. The mixed distribution is correct as a per-pixel expectation and wrong as a description of any one pixel."},
{"prompt": "plywood hoarding", "kind": "surface", "entity": {"facade": 0.7, "barrier": 0.3}, "material": {"plywood": 0.7, "chipboard": 0.15, "wood": 0.1, "unknown": 0.05}, "attributes": {"fixed": 0.8, "transient": 0.6, "thin": 0.85, "smooth": 0.6, "layered": 0.95},
     "caveat": "Construction hoarding is transient by construction. It is a real scatterer on the day the panorama was captured and may be gone months later, which is why the transient prior is high."},
{"prompt": "oriented strand board panel", "kind": "surface", "entity": {"facade": 0.6, "barrier": 0.4}, "material": {"chipboard": 0.7, "plywood": 0.15, "wood": 0.1, "unknown": 0.05}, "attributes": {"fixed": 0.8, "transient": 0.6, "thin": 0.85, "rough": 0.6, "layered": 0.9},
     "caveat": "Separable from plywood only by flake texture, which needs a close view. Beyond roughly 20 m the two prompts should be treated as one."},
{"prompt": "open archway", "kind": "surface", "entity": {"opening": 1.0}, "material": {"air": 0.9, "unknown": 0.1}, "attributes": {"fixed": 0.99, "hollow": 0.99},
     "caveat": "An aperture, not a surface. It exists in the catalogue so that a hole in a facade is exported as a transmitting region rather than being filled in by the photogrammetry's closed shell."},
{"prompt": "roof tile", "kind": "surface", "entity": {"roof": 1.0}, "material": {"ceramic": 0.78, "brick": 0.1, "concrete": 0.07, "unknown": 0.05}, "attributes": {"fixed": 0.99, "rough": 0.7, "layered": 0.9, "periodic": 0.85}},
{"prompt": "slate roof", "kind": "surface", "entity": {"roof": 1.0}, "material": {"marble": 0.75, "ceramic": 0.1, "unknown": 0.15}, "attributes": {"fixed": 0.99, "smooth": 0.6, "thin": 0.7, "layered": 0.95, "periodic": 0.7},
     "caveat": "Slate is bound to the marble row because it is the only stone in the table. Slate is markedly more anisotropic and the substitution is a placeholder."},
{"prompt": "metal roof", "kind": "surface", "entity": {"roof": 1.0}, "material": {"metal": 0.9, "unknown": 0.1}, "attributes": {"fixed": 0.98, "thin": 0.85, "reflective": 0.85, "conductive": 0.97, "periodic": 0.55}},
{"prompt": "glass roof", "kind": "surface", "entity": {"roof": 0.6, "window": 0.4}, "material": {"glass": 0.82, "metal": 0.13, "unknown": 0.05}, "attributes": {"fixed": 0.98, "thin": 0.7, "reflective": 0.85, "transparent": 0.85, "smooth": 0.95, "layered": 0.7, "periodic": 0.6, "metallised": 0.25}},
{"prompt": "solar panel", "kind": "surface", "entity": {"solar_panel": 1.0}, "material": {"glass": 0.55, "metal": 0.35, "polymer": 0.1}, "attributes": {"fixed": 0.98, "thin": 0.75, "reflective": 0.85, "smooth": 0.95, "conductive": 0.8, "layered": 0.98, "periodic": 0.7, "metallised": 0.9},

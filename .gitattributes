# ── Line endings ──────────────────────────────────────────────
# Normalize to LF in the repo, native on checkout
* text=auto

# Force LF for source code (even on Windows)
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.csv text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.sh text eol=lf

# ── Binary files (no diff, no merge, no line-ending mangling) ─
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.stl binary
*.ply binary
*.fbx binary
*.glb binary
*.sqlite.gz binary

# ── GitHub Linguist ──────────────────────────────────────────
# Notebooks are generated (hide from diffs and language stats)
*.ipynb linguist-generated

# Lock file: generated, reviewable but not language stats
uv.lock linguist-generated
aegis-web/package-lock.json linguist-generated

# Bundled React build served by Flask: generated
src/aegis/viewer/static/** linguist-generated

# Vendor fonts: generated
src/aegis/viewer/static/assets/*.woff linguist-generated
src/aegis/viewer/static/assets/*.woff2 linguist-generated
src/aegis/viewer/static/assets/*.ttf linguist-generated

# Data files: not code
data/** linguist-vendored

# Documentation build output
site/** linguist-generated

# Let LaTeX count as code in language stats
*.tex linguist-detectable

# ── Diff drivers ─────────────────────────────────────────────
# Better diffs for Python (use function names as hunk headers)
*.py diff=python

# Treat notebooks as binary in diffs (use nbdime or similar)
*.ipynb -diff

# No useful diff for mesh data
*.stl -diff
*.ply -diff

# ── Merge strategies ─────────────────────────────────────────
# Lock files: accept the new version on conflicts, regenerate after
uv.lock merge=binary
aegis-web/package-lock.json merge=binary

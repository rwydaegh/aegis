  "material_grounding": {
    "grounding_note": "Each material label on the concept axis is bound to the RF library row that supplies its frequency-dependent dielectric model. A label with no row is not a defect to hide: it marks where the concept catalogue names a physical surface that Recommendation ITU-R P.2040-4 Table 3 does not tabulate.",
    "materials": {
      "unknown": {"library": "none", "row": null, "status": "no_model", "note": "Deliberate. Carries the residual mass of every concept whose material the imagery does not determine, so an unresolved surface stays visible as posterior entropy instead of being forced onto a default."},
      "air": {"library": "itu_p2040_4", "row": "vacuum_air", "status": "bound", "note": "The material of an aperture. An arcade opening or an open archway is a hole in the facade, and the exporter needs it to be a transmitting surface rather than a scatterer."},
      "brick": {"library": "itu_p2040_4", "row": "brick", "status": "bound", "note": "Tabulated to 40 GHz only."},
      "concrete": {"library": "itu_p2040_4", "row": "concrete", "status": "bound"},
      "plasterboard": {"library": "itu_p2040_4", "row": "plasterboard", "status": "bound", "note": "Used as the closest tabulated stand-in for exterior lime and cement render. That is a substitution, not a measurement: render is denser than gypsum plasterboard, so this row biases the permittivity low."},
      "plywood": {"library": "itu_p2040_4", "row": "plywood", "status": "bound", "note": "Tabulated to 40 GHz only. Reached outdoors through construction hoarding and boarded shopfronts, which is a real and common city-centre surface."},
      "chipboard": {"library": "itu_p2040_4", "row": "chipboard", "status": "bound", "note": "Oriented strand board hoarding. Discriminated from plywood by flake texture, which needs a close view: at long range the two collapse."},
      "wood": {"library": "itu_p2040_4", "row": "wood", "status": "bound"},
      "glass": {"library": "itu_p2040_4", "row": "glass", "status": "bound", "note": "The row is plain float glass. It does not describe a metallised low-emissivity coating, which is why the metallised attribute is carried separately."},
      "metal": {"library": "itu_p2040_4", "row": "metal", "status": "bound"},
      "marble": {"library": "itu_p2040_4", "row": "marble", "status": "bound", "note": "The only dimension-stone row in the table, so it carries limestone, granite, sandstone and slate as well. Their real permittivity spans roughly 5 to 9 against marble's 7.07, and the imagery cannot tell them apart, so the substitution is recorded here rather than being silently absorbed."},
      "asphalt_concrete": {"library": "itu_p2040_4", "row": "asphalt_concrete", "status": "bound", "note": "Tabulated to 40 GHz only."},
      "ceramic": {"library": "none", "row": null, "status": "no_row", "note": "Fired clay roof tile and glazed facade tile. Recommendation ITU-R P.2040-4 Table 3 has no ceramic row. Brick is the nearest fired-clay row but is more porous, so the substitution is left to the caller instead of being baked in here."},
      "polymer": {"library": "none", "row": null, "status": "no_row", "note": "Thermoplastic street furniture and road-marking paint. No P.2040 row."},
      "fabric": {"library": "none", "row": null, "status": "no_row", "note": "Awning and parasol canvas. No P.2040 row. Electrically thin at millimetre wave, so the slab response needs a thickness the imagery cannot supply."},
      "soil": {"library": "itu_r_p527_6", "row": null, "status": "different_recommendation", "note": "Ground must come from Recommendation ITU-R P.527-6. P.2040 Table 3 does carry ground rows but they must not be extrapolated above 10 GHz, which is far below this study's band. Not implemented in semantic_twin/materials.py yet."},
      "water": {"library": "itu_r_p527_6", "row": null, "status": "different_recommendation", "note": "Same as soil."},
      "vegetation_effective": {"library": "itu_r_p833_10", "row": null, "status": "different_recommendation", "note": "Vegetation is a lossy volume, not a slab, so Recommendation ITU-R P.833-10 replaces the P.2040 surface model. Not implemented yet."},
      "human_tissue": {"library": "itis_tissue_database", "row": null, "status": "different_library", "note": "Bodies are handled by the dosimetry engine, not by the scene material library."},
      "vehicle_composite": {"library": "none", "row": null, "status": "not_a_material", "note": "A vehicle is a layered metal-and-glass shell, not a homogeneous half space. Kept as an explicit placeholder so the exporter cannot mistake it for a tabulated dielectric."}
    }
  },

